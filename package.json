    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.158.0"
  }
