{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epb-dungun",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-01",
  // Local-only placeholder. Replace via environment-specific configuration after approval.
  "d1_databases": [{ "binding": "DB", "database_name": "epb-dungun-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "PUBLIC_DATA_ENABLED": "false" },
  // Pages preview only: never shared with the top-level/production binding.
  "env": {
    "preview": {
      "d1_databases": [{ "binding": "DB", "database_name": "epb-dungun-staging", "database_id": "20235c71-0c91-428c-80a3-06eee3eab20e", "migrations_dir": "migrations" }],
      "vars": { "PUBLIC_DATA_ENABLED": "false" }
    }
  }
}
